# Frontal de production de Fracas (Caddy 2). Routes et en-têtes : les mêmes que deploy/routes.ts
# (un test le vérifie). TLS automatique (Let's Encrypt) pour le domaine de DOMAIN.
{
	# Adresse de contact pour Let's Encrypt (facultative, mais conseillée).
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "gamepad=(self), camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Les rapports de match ne viennent que du serveur de jeu, par le réseau interne ; la santé
	# des serveurs ne se lit pas depuis Internet.
	@blocked {
		path /api/ranking/v1/matches /api/ranking/v1/matches/* /health /health/*
	}
	respond @blocked "Introuvable." 404

	handle /api/accounts/* {
		reverse_proxy accounts:8787
	}
	handle /api/ranking/* {
		reverse_proxy accounts:8787
	}
	handle /lobby {
		reverse_proxy game:8788
	}
	handle /net {
		reverse_proxy game:8788
	}

	handle {
		root * /srv
		# Fichiers à empreinte : un an ; tout le reste (index.html) : jamais en cache.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		# Modèles et HDRI : leur version .gz faite au build (Dockerfile), si le navigateur l'accepte.
		file_server {
			precompressed gzip
		}
	}

	# Journal réduit : adresses IP tronquées, ni cookie ni en-tête d'autorisation.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Forwarded-For delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

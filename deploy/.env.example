# Configuration de production de Fracas. Copier en deploy/.env (jamais commité), puis remplir.
# Les clés se génèrent par : node deploy/generate-secrets.ts

# Nom de domaine du jeu (enregistrement DNS A/AAAA vers la machine). Exemple : fracas.example
DOMAIN=
# Adresse de contact pour Let's Encrypt (facultative).
ACME_EMAIL=

# Clés de ticket des comptes, partagées avec le serveur de jeu (32 caractères au moins).
# Plusieurs, séparées par des virgules : la première signe, toutes sont acceptées (rotation).
ACCOUNTS_TICKET_SECRETS=
# Clés de signature des rapports de match (serveur de jeu → classement), distinctes des précédentes.
RANKING_REPORT_SECRETS=

# Parties simultanées au plus dans le relais : environ 3,4 Mo par partie de 30 min à 8 au pire.
# 200 ≈ 700 Mo au pire ; à ajuster selon la mémoire de la machine.
RELAY_MAX_GAMES=200

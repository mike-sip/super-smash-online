{
  "name": "@game/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm --filter @game/stages-items build && tsc --noEmit && tsc --noEmit -p tools",
    "build": "pnpm --filter @game/stages-items build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@game/sim-core": "workspace:*",
    "@game/stages-items": "workspace:*",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

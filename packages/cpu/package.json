{
  "name": "@game/cpu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm --filter @game/fighters build && pnpm --filter @game/stages-items build && pnpm --filter @game/match-rules build && tsc --noEmit",
    "build": "pnpm --filter @game/sim-core build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@game/sim-core": "workspace:*"
  },
  "devDependencies": {
    "@game/fighters": "workspace:*",
    "@game/match-rules": "workspace:*",
    "@game/stages-items": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

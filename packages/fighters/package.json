{
  "name": "@game/fighters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm --filter @game/sim-core build && tsc --noEmit",
    "build": "pnpm --filter @game/sim-core build && tsc -p tsconfig.build.json",
    "validate": "pnpm --filter @game/sim-core build && node scripts/validate.ts",
    "framedata": "pnpm --filter @game/sim-core build && node scripts/framedata.ts",
    "bench": "pnpm --filter @game/sim-core build && node bench/step.bench.ts"
  },
  "dependencies": {
    "@game/sim-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
